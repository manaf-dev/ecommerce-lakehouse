{
  "Comment": "E-Commerce Lakehouse Pipeline — Glue Delta ingest, Athena smoke check, Lambda archival.",
  "StartAt": "PrepareContext",
  "States": {

    "PrepareContext": {
      "Type": "Pass",
      "Parameters": {
        "bucket.$": "$.bucket",
        "order_month.$": "$.order_month",
        "run_id.$": "$$.Execution.Name"
      },
      "Next": "IngestParallel"
    },

    "IngestParallel": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "IngestProducts",
          "States": {
            "IngestProducts": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "${project}-ingest-delta",
                "Arguments": {
                  "--dataset": "products",
                  "--raw_prefix.$": "States.Format('s3://{}/raw/products/', $.bucket)",
                  "--target_path.$": "States.Format('s3://{}/lakehouse-dwh/products/', $.bucket)",
                  "--quarantine_path.$": "States.Format('s3://{}/quarantine/products/', $.bucket)",
                  "--catalog_db": "${catalog_db_name}",
                  "--run_id.$": "$.run_id"
                }
              },
              "Retry": [
                {
                  "ErrorEquals": ["States.ALL"],
                  "MaxAttempts": 2,
                  "BackoffRate": 2.0,
                  "IntervalSeconds": 30
                }
              ],
              "End": true
            }
          }
        },
        {
          "StartAt": "IngestOrders",
          "States": {
            "IngestOrders": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "${project}-ingest-delta",
                "Arguments": {
                  "--dataset": "orders",
                  "--raw_prefix.$": "States.Format('s3://{}/raw/orders/', $.bucket)",
                  "--target_path.$": "States.Format('s3://{}/lakehouse-dwh/orders/', $.bucket)",
                  "--quarantine_path.$": "States.Format('s3://{}/quarantine/orders/', $.bucket)",
                  "--catalog_db": "${catalog_db_name}",
                  "--run_id.$": "$.run_id"
                }
              },
              "Retry": [
                {
                  "ErrorEquals": ["States.ALL"],
                  "MaxAttempts": 2,
                  "BackoffRate": 2.0,
                  "IntervalSeconds": 30
                }
              ],
              "End": true
            }
          }
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "PublishFailureAlert",
          "ResultPath": "$.Error"
        }
      ],
      "ResultPath": "$.IngestParallelResult",
      "Next": "IngestOrderItems"
    },

    "IngestOrderItems": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "${project}-ingest-delta",
        "Arguments": {
          "--dataset": "order_items",
          "--raw_prefix.$": "States.Format('s3://{}/raw/order_items/', $.bucket)",
          "--target_path.$": "States.Format('s3://{}/lakehouse-dwh/order_items/', $.bucket)",
          "--quarantine_path.$": "States.Format('s3://{}/quarantine/order_items/', $.bucket)",
          "--orders_path.$": "States.Format('s3://{}/lakehouse-dwh/orders/', $.bucket)",
          "--products_path.$": "States.Format('s3://{}/lakehouse-dwh/products/', $.bucket)",
          "--catalog_db": "${catalog_db_name}",
          "--run_id.$": "$.run_id"
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "MaxAttempts": 2,
          "BackoffRate": 2.0,
          "IntervalSeconds": 30
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "PublishFailureAlert",
          "ResultPath": "$.Error"
        }
      ],
      "ResultPath": "$.IngestOrderItemsResult",
      "Next": "RunAthenaValidation"
    },

    "RunAthenaValidation": {
      "Type": "Task",
      "Comment": "Single smoke query — all three tables must have rows.",
      "Resource": "arn:aws:states:::athena:startQueryExecution.sync",
      "Parameters": {
        "QueryString.$": "States.Format('SELECT (SELECT COUNT(*) FROM products) + (SELECT COUNT(*) FROM orders WHERE order_month = \\'{}\\') + (SELECT COUNT(*) FROM order_items WHERE order_month = \\'{}\\') AS total_rows', $.order_month, $.order_month)",
        "WorkGroup": "${workgroup_name}",
        "QueryExecutionContext": {
          "Database": "${catalog_db_name}"
        },
        "ResultConfiguration": {
          "OutputLocation.$": "States.Format('s3://{}/athena-results/', $.bucket)"
        }
      },
      "ResultPath": "$.AthenaValidation",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "MaxAttempts": 2,
          "BackoffRate": 2.0,
          "IntervalSeconds": 10
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "PublishFailureAlert",
          "ResultPath": "$.Error"
        }
      ],
      "Next": "GetAthenaResults"
    },

    "GetAthenaResults": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:athena:getQueryResults",
      "Parameters": {
        "QueryExecutionId.$": "$.AthenaValidation.QueryExecution.QueryExecutionId"
      },
      "ResultPath": "$.QueryResults",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "MaxAttempts": 2,
          "BackoffRate": 2.0,
          "IntervalSeconds": 10
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "PublishFailureAlert",
          "ResultPath": "$.Error"
        }
      ],
      "Next": "CheckRowCount"
    },

    "CheckRowCount": {
      "Type": "Choice",
      "Choices": [
        {
          "Not": {
            "Variable": "$.QueryResults.ResultSet.Rows[1].Data[0].VarCharValue",
            "StringEquals": "0"
          },
          "Next": "ArchiveFiles"
        }
      ],
      "Default": "PublishFailureAlert"
    },

    "ArchiveFiles": {
      "Type": "Task",
      "Comment": "Archive raw files via Lambda after successful validation.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "OutputPath": "$.Payload",
      "Parameters": {
        "FunctionName": "${archive_lambda_name}",
        "Payload": {
          "bucket.$": "$.bucket",
          "run_id.$": "$.run_id"
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "MaxAttempts": 2,
          "BackoffRate": 2.0,
          "IntervalSeconds": 15
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "PublishFailureAlert",
          "ResultPath": "$.Error"
        }
      ],
      "Next": "PipelineSuccess"
    },

    "PipelineSuccess": {
      "Type": "Succeed"
    },

    "PublishFailureAlert": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:sns:publish",
      "Parameters": {
        "TopicArn": "${sns_topic_arn}",
        "Subject": "Lakehouse Pipeline Failure",
        "Message.$": "States.Format('Lakehouse pipeline failed — execution: {}, order_month: {}', $$.Execution.Name, $.order_month)"
      },
      "Next": "PipelineFail"
    },

    "PipelineFail": {
      "Type": "Fail",
      "Error": "PipelineFailed",
      "Cause": "See SNS alert and CloudWatch logs for details."
    }

  }
}
