{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3CreateBucket",
      "Effect": "Allow",
      "Action": "s3:CreateBucket",
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "s3:BucketName": ["LAKEHOUSE_BUCKET", "TF_STATE_BUCKET"]
        }
      }
    },
    {
      "Sid": "S3LakehouseAndState",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::LAKEHOUSE_BUCKET",
        "arn:aws:s3:::LAKEHOUSE_BUCKET/*",
        "arn:aws:s3:::TF_STATE_BUCKET",
        "arn:aws:s3:::TF_STATE_BUCKET/*"
      ]
    },
    {
      "Sid": "IAMRolesForLakehouse",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:UpdateRole",
        "iam:UpdateRoleDescription",
        "iam:ListRoles",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:ListRoleTags",
        "iam:ListInstanceProfilesForRole"
      ],
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/PROJECT-*"
    },
    {
      "Sid": "IAMAttachGlueServiceRole",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::ACCOUNT_ID:role/PROJECT-*",
        "arn:aws:iam::aws:policy/service-role/AWSGlueServiceRole"
      ]
    },
    {
      "Sid": "IAMPassRoleToServices",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/PROJECT-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "glue.amazonaws.com",
            "lambda.amazonaws.com",
            "states.amazonaws.com",
            "events.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "GlueJobsAndCatalog",
      "Effect": "Allow",
      "Action": [
        "glue:CreateJob",
        "glue:DeleteJob",
        "glue:UpdateJob",
        "glue:GetJob",
        "glue:GetJobs",
        "glue:BatchGetJobs",
        "glue:CreateDatabase",
        "glue:DeleteDatabase",
        "glue:GetDatabase",
        "glue:GetDatabases",
        "glue:UpdateDatabase",
        "glue:CreateTable",
        "glue:DeleteTable",
        "glue:GetTable",
        "glue:GetTables",
        "glue:UpdateTable",
        "glue:TagResource",
        "glue:UntagResource",
        "glue:GetTags"
      ],
      "Resource": [
        "arn:aws:glue:AWS_REGION:ACCOUNT_ID:job/PROJECT-*",
        "arn:aws:glue:AWS_REGION:ACCOUNT_ID:catalog",
        "arn:aws:glue:AWS_REGION:ACCOUNT_ID:database/lakehouse_dwh",
        "arn:aws:glue:AWS_REGION:ACCOUNT_ID:table/lakehouse_dwh/*"
      ]
    },
    {
      "Sid": "LambdaFunctions",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:DeleteFunction",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:ListVersionsByFunction",
        "lambda:PublishVersion",
        "lambda:AddPermission",
        "lambda:RemovePermission",
        "lambda:GetPolicy",
        "lambda:CreateEventSourceMapping",
        "lambda:DeleteEventSourceMapping",
        "lambda:GetEventSourceMapping",
        "lambda:UpdateEventSourceMapping",
        "lambda:ListEventSourceMappings",
        "lambda:PutFunctionConcurrency",
        "lambda:DeleteFunctionConcurrency",
        "lambda:GetFunctionConcurrency",
        "lambda:GetFunctionCodeSigningConfig",
        "lambda:TagResource",
        "lambda:UntagResource",
        "lambda:ListTags"
      ],
      "Resource": "arn:aws:lambda:AWS_REGION:ACCOUNT_ID:function:PROJECT-*"
    },
    {
      "Sid": "LambdaEventSourceMappings",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateEventSourceMapping",
        "lambda:DeleteEventSourceMapping",
        "lambda:GetEventSourceMapping",
        "lambda:UpdateEventSourceMapping",
        "lambda:ListEventSourceMappings"
      ],
      "Resource": "arn:aws:lambda:AWS_REGION:ACCOUNT_ID:event-source-mapping:*"
    },
    {
      "Sid": "StepFunctions",
      "Effect": "Allow",
      "Action": [
        "states:CreateStateMachine",
        "states:DeleteStateMachine",
        "states:UpdateStateMachine",
        "states:DescribeStateMachine",
        "states:ListStateMachines",
        "states:ListStateMachineVersions",
        "states:ListTagsForResource",
        "states:TagResource",
        "states:UntagResource"
      ],
      "Resource": "arn:aws:states:AWS_REGION:ACCOUNT_ID:stateMachine:PROJECT-*"
    },
    {
      "Sid": "StepFunctionsValidate",
      "Effect": "Allow",
      "Action": "states:ValidateStateMachineDefinition",
      "Resource": "*"
    },
    {
      "Sid": "EventBridge",
      "Effect": "Allow",
      "Action": [
        "events:PutRule",
        "events:DeleteRule",
        "events:DescribeRule",
        "events:ListRules",
        "events:EnableRule",
        "events:DisableRule",
        "events:PutTargets",
        "events:RemoveTargets",
        "events:ListTargetsByRule",
        "events:ListTagsForResource",
        "events:TagResource",
        "events:UntagResource"
      ],
      "Resource": "arn:aws:events:AWS_REGION:ACCOUNT_ID:rule/PROJECT-*"
    },
    {
      "Sid": "SQS",
      "Effect": "Allow",
      "Action": [
        "sqs:CreateQueue",
        "sqs:DeleteQueue",
        "sqs:GetQueueAttributes",
        "sqs:SetQueueAttributes",
        "sqs:GetQueueUrl",
        "sqs:ListQueueTags",
        "sqs:TagQueue",
        "sqs:UntagQueue",
        "sqs:GetQueuePolicy",
        "sqs:SetQueuePolicy",
        "sqs:DeleteQueuePolicy"
      ],
      "Resource": "arn:aws:sqs:AWS_REGION:ACCOUNT_ID:PROJECT-*"
    },
    {
      "Sid": "SNS",
      "Effect": "Allow",
      "Action": [
        "sns:CreateTopic",
        "sns:DeleteTopic",
        "sns:GetTopicAttributes",
        "sns:SetTopicAttributes",
        "sns:Subscribe",
        "sns:Unsubscribe",
        "sns:ListSubscriptionsByTopic",
        "sns:GetSubscriptionAttributes",
        "sns:SetSubscriptionAttributes",
        "sns:ListTagsForResource",
        "sns:TagResource",
        "sns:UntagResource"
      ],
      "Resource": "arn:aws:sns:AWS_REGION:ACCOUNT_ID:PROJECT-*"
    },
    {
      "Sid": "Athena",
      "Effect": "Allow",
      "Action": [
        "athena:CreateWorkGroup",
        "athena:DeleteWorkGroup",
        "athena:UpdateWorkGroup",
        "athena:GetWorkGroup",
        "athena:ListWorkGroups",
        "athena:ListTagsForResource",
        "athena:TagResource",
        "athena:UntagResource"
      ],
      "Resource": "arn:aws:athena:AWS_REGION:ACCOUNT_ID:workgroup/PROJECT-*"
    },
    {
      "Sid": "CloudWatchLogsDescribe",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups",
        "logs:DescribeLogDeliveries",
        "logs:DescribeResourcePolicies",
        "logs:DescribeLogStreams",
        "logs:ListLogStreams"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CloudWatchLogsManage",
      "Effect": "Allow",
      "Action": "logs:*",
      "Resource": [
        "arn:aws:logs:AWS_REGION:ACCOUNT_ID:log-group:/aws/lambda/PROJECT-*",
        "arn:aws:logs:AWS_REGION:ACCOUNT_ID:log-group:/aws/lambda/PROJECT-*:*",
        "arn:aws:logs:AWS_REGION:ACCOUNT_ID:log-group:/aws/states/PROJECT-*",
        "arn:aws:logs:AWS_REGION:ACCOUNT_ID:log-group:/aws/states/PROJECT-*:*",
        "arn:aws:logs:AWS_REGION:ACCOUNT_ID:log-group:/aws-glue/jobs/PROJECT-*",
        "arn:aws:logs:AWS_REGION:ACCOUNT_ID:log-group:/aws-glue/jobs/PROJECT-*:*"
      ]
    },
    {
      "Sid": "STSCallerIdentity",
      "Effect": "Allow",
      "Action": ["sts:GetCallerIdentity"],
      "Resource": "*"
    }
  ]
}
