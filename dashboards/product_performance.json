{
  "__inputs": [
    {
      "name": "DS_ATHENA",
      "label": "Athena",
      "description": "Amazon Athena datasource configured in Grafana Cloud",
      "type": "datasource",
      "pluginId": "grafana-athena-datasource",
      "pluginName": "Amazon Athena"
    }
  ],
  "__elements": {},
  "__requires": [
    { "type": "grafana",    "id": "grafana",                       "name": "Grafana",       "version": "10.0.0" },
    { "type": "datasource", "id": "grafana-athena-datasource",     "name": "Amazon Athena", "version": "2.0.0"  },
    { "type": "panel",      "id": "stat",                          "name": "Stat",          "version": ""       },
    { "type": "panel",      "id": "barchart",                      "name": "Bar chart",     "version": ""       },
    { "type": "panel",      "id": "piechart",                      "name": "Pie chart",     "version": ""       },
    { "type": "panel",      "id": "table",                         "name": "Table",         "version": ""       }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Product order frequency, department breakdown, and reorder rates.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": false,
      "tags": ["ecommerce"],
      "targetBlank": true,
      "title": "Revenue Overview",
      "tooltip": "",
      "type": "dashboards",
      "url": ""
    }
  ],
  "panels": [

    {
      "datasource": { "type": "grafana-athena-datasource", "uid": "${DS_ATHENA}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "connectionArgs": { "catalog": "AwsDataCatalog", "database": "lakehouse_dwh", "region": "default" },
          "format": 1,
          "rawSQL": "SELECT COUNT(*) AS \"Total Products\" FROM products",
          "refId": "A"
        }
      ],
      "title": "Total Products",
      "type": "stat"
    },

    {
      "datasource": { "type": "grafana-athena-datasource", "uid": "${DS_ATHENA}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "connectionArgs": { "catalog": "AwsDataCatalog", "database": "lakehouse_dwh", "region": "default" },
          "format": 1,
          "rawSQL": "SELECT COUNT(DISTINCT department) AS \"Departments\" FROM products",
          "refId": "A"
        }
      ],
      "title": "Departments",
      "type": "stat"
    },

    {
      "datasource": { "type": "grafana-athena-datasource", "uid": "${DS_ATHENA}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "connectionArgs": { "catalog": "AwsDataCatalog", "database": "lakehouse_dwh", "region": "default" },
          "format": 1,
          "rawSQL": "SELECT COUNT(id) AS \"Total Items Ordered\" FROM order_items",
          "refId": "A"
        }
      ],
      "title": "Total Items Ordered",
      "type": "stat"
    },

    {
      "datasource": { "type": "grafana-athena-datasource", "uid": "${DS_ATHENA}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 30   },
              { "color": "red",    "value": 60   }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "connectionArgs": { "catalog": "AwsDataCatalog", "database": "lakehouse_dwh", "region": "default" },
          "format": 1,
          "rawSQL": "SELECT ROUND(CAST(SUM(reordered) AS DOUBLE) / NULLIF(COUNT(id), 0) * 100, 1) AS \"Reorder Rate %\" FROM order_items",
          "refId": "A"
        }
      ],
      "title": "Overall Reorder Rate",
      "type": "stat"
    },

    {
      "datasource": { "type": "grafana-athena-datasource", "uid": "${DS_ATHENA}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 80, "gradientMode": "none", "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "lineWidth": 1 }
        }
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 4 },
      "id": 5,
      "options": {
        "barRadius": 0.05,
        "barWidth": 0.7,
        "fullHighlight": false,
        "groupWidth": 0.7,
        "legend": { "displayMode": "list", "placement": "right", "showLegend": true },
        "orientation": "horizontal",
        "stacking": "none",
        "tooltip": { "mode": "single", "sort": "none" },
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 100
      },
      "targets": [
        {
          "connectionArgs": { "catalog": "AwsDataCatalog", "database": "lakehouse_dwh", "region": "default" },
          "format": 1,
          "rawSQL": "SELECT product_name AS \"Product\", times_ordered AS \"Times Ordered\", reorder_rate_pct AS \"Reorder Rate %\" FROM top_products ORDER BY times_ordered DESC LIMIT 15",
          "refId": "A"
        }
      ],
      "title": "Top 15 Products by Order Frequency",
      "type": "barchart"
    },

    {
      "datasource": { "type": "grafana-athena-datasource", "uid": "${DS_ATHENA}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } }
      },
      "gridPos": { "h": 9, "w": 10, "x": 0, "y": 14 },
      "id": 6,
      "options": {
        "displayLabels": ["percent"],
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "values": ["value", "percent"] },
        "pieType": "pie",
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "connectionArgs": { "catalog": "AwsDataCatalog", "database": "lakehouse_dwh", "region": "default" },
          "format": 1,
          "rawSQL": "SELECT department AS \"Department\", total_items_ordered AS \"Items Ordered\" FROM dept_breakdown ORDER BY total_items_ordered DESC",
          "refId": "A"
        }
      ],
      "title": "Items Ordered by Department",
      "type": "piechart"
    },

    {
      "datasource": { "type": "grafana-athena-datasource", "uid": "${DS_ATHENA}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "fillOpacity": 80, "gradientMode": "none", "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "lineWidth": 1 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 40   },
              { "color": "red",    "value": 60   }
            ]
          }
        }
      },
      "gridPos": { "h": 9, "w": 14, "x": 10, "y": 14 },
      "id": 7,
      "options": {
        "barRadius": 0.05,
        "barWidth": 0.7,
        "fullHighlight": false,
        "groupWidth": 0.7,
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "orientation": "horizontal",
        "stacking": "none",
        "tooltip": { "mode": "single", "sort": "none" },
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 100
      },
      "targets": [
        {
          "connectionArgs": { "catalog": "AwsDataCatalog", "database": "lakehouse_dwh", "region": "default" },
          "format": 1,
          "rawSQL": "SELECT department AS \"Department\", reorder_rate_pct AS \"Reorder Rate %\" FROM dept_breakdown ORDER BY reorder_rate_pct DESC",
          "refId": "A"
        }
      ],
      "title": "Reorder Rate by Department",
      "type": "barchart"
    },

    {
      "datasource": { "type": "grafana-athena-datasource", "uid": "${DS_ATHENA}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "filterable": true,
            "inspect": false
          },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Reorder Rate %" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "custom.cellOptions", "value": { "mode": "gradient", "type": "gauge" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 40 }, { "color": "red", "value": 60 }] } }
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 23 },
      "id": 8,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Times Ordered" }]
      },
      "targets": [
        {
          "connectionArgs": { "catalog": "AwsDataCatalog", "database": "lakehouse_dwh", "region": "default" },
          "format": 1,
          "rawSQL": "SELECT product_name AS \"Product\", department AS \"Department\", times_ordered AS \"Times Ordered\", distinct_orders AS \"Distinct Orders\", reorder_count AS \"Reorders\", reorder_rate_pct AS \"Reorder Rate %\" FROM top_products ORDER BY times_ordered DESC LIMIT 50",
          "refId": "A"
        }
      ],
      "title": "Product Detail Table",
      "type": "table"
    }

  ],
  "refresh": "",
  "schemaVersion": 38,
  "tags": ["ecommerce", "lakehouse", "products"],
  "templating": { "list": [] },
  "time": { "from": "now-1y", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "E-Commerce Product Performance",
  "uid": "ecommerce-product-performance",
  "version": 1,
  "weekStart": ""
}
